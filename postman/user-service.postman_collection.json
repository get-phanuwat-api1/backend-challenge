                  "const body = pm.response.json();",
                  "pm.test(\"successful = false\", () => pm.expect(body.successful).to.eql(false));",
                  "pm.test(\"error_code = \\\"EMAIL_ALREADY_EXISTS\\\"\", () => pm.expect(body.error_code).to.eql(\"EMAIL_ALREADY_EXISTS\"));"
                ]
              }
